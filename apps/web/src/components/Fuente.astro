---
/**
 * Ficha de procedencia (ADR-003).
 *
 * Toda cifra que muestra el sitio va acompañada de su fuente, un enlace donde
 * comprobarla y cuándo se tomó. Es lo único que separa esto de cualquier otra página de
 * crisis: una cifra sin procedencia no es verificable, y en una emergencia lo no
 * verificable termina funcionando como desinformación.
 */
interface Props {
  nombre: string;
  url: string;
  tipo: string;
  /** ISO 8601. */
  observado: string;
  detalle?: string;
}

const { nombre, url, tipo, observado, detalle } = Astro.props;

const fecha = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'America/Bogota',
}).format(new Date(observado));
---

<section class="fuente" aria-labelledby="t-fuente">
  <h2 id="t-fuente">Procedencia de los datos</h2>

  <dl>
    <div>
      <dt>Fuente</dt>
      <dd><a href={url}>{nombre}</a> <span class="tipo">{tipo}</span></dd>
    </div>
    {
      detalle && (
        <div>
          <dt>Producto</dt>
          <dd>{detalle}</dd>
        </div>
      )
    }
    <div>
      <dt>Actualizado</dt>
      <dd><time datetime={observado}>{fecha}</time> <span class="tz">(hora de Colombia)</span></dd>
    </div>
  </dl>

  <p class="explica">
    Los datos se vuelven a consultar automáticamente cada 15 minutos. Cada cambio de cada
    cifra queda registrado en el historial del repositorio, así que cualquiera puede
    auditar de dónde salió un número y cuándo cambió.
  </p>
</section>

<style>
  .fuente {
    background: var(--fondo-2);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    padding: 1.25rem 1.4rem 1.4rem;
  }

  h2 {
    margin: 0 0 0.9rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tinta-3);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.9rem 1.5rem;
    margin: 0;
  }

  dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tinta-3);
  }

  dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }

  .tipo {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0.05em 0.5em;
    border-radius: 999px;
    background: var(--fondo-3);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--tinta-2);
    vertical-align: 1px;
  }

  .tz {
    font-weight: 400;
    color: var(--tinta-3);
    font-size: 0.85rem;
  }

  .explica {
    margin: 1.1rem 0 0;
    font-size: 0.85rem;
    color: var(--tinta-2);
    max-width: 65ch;
  }
</style>
