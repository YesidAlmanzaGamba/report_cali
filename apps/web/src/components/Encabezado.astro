---
/**
 * Encabezado compacto. En un celular no puede robarle pantalla al mapa, así que se
 * queda en ~52 px y guarda el detalle del evento para la hoja.
 *
 * El botón «¿Buscas a un familiar?» vive aquí y no dentro de la hoja, a propósito
 * (ADR-001): quien llega buscando a alguien no puede tener que aprender un gesto
 * primero. Es un enlace de verdad a `#buscas`, así que sin JavaScript baja a la
 * sección; con JavaScript abre la hoja en ese módulo.
 *
 * **El encabezado entero se repliega a los 10 s (con JavaScript) y no vuelve.** Es
 * una anulación explícita de ADR-001, pedida y confirmada por el responsable del
 * proyecto tras señalarle la contradicción. Sin JavaScript se queda fijo, así que
 * ADR-001 se sostiene igual que siempre para quien navega sin JS. Registrado en
 * `docs/COORDINACION.md` para que `agente-datos`, dueño de ese ADR, lo vea.
 *
 * **Se probó primero un repliegue reactivo** —oculto mientras se arrastra o hace
 * zoom en el mapa, de vuelta al soltar (`mapa.ts` en `movestart`/`moveend`)— y produjo
 * un bucle de parpadeo real: `mapa.resize()` dispara sus propios eventos de
 * movimiento, y el `ResizeObserver` que ya vigilaba el mapa volvía a llamarlo cada vez
 * que el encabezado cambiaba de tamaño. Encontrado en vivo, por reporte directo, dos
 * veces. Se reemplazó por esto: un solo temporizador, sin lógica reactiva con la que
 * pueda entrar en bucle.
 */
interface Props {
  magnitud: number;
  alerta: string | null;
  fechaLocal: string;
}

const { magnitud, alerta, fechaLocal } = Astro.props;
---

<header class="encabezado">
  <div class="fila">
    <div class="identidad">
      <h1>
        Terremoto de Colombia
        <span class="detalle">M{magnitud} · {fechaLocal}</span>
      </h1>
    </div>

    {
      alerta === 'red' && (
        <span class="alerta" title="Nivel de alerta PAGER del USGS">
          Alerta roja
        </span>
      )
    }
  </div>

  <a class="buscas" href="#buscas" data-modulo="ayuda">
    ¿Buscas a un familiar?
  </a>
</header>

<script>
  // Anulación explícita de ADR-001 — ver el docblock de arriba antes de tocar esto.
  // Un solo temporizador para todo el encabezado: no vuelve a aparecer, así que no hay
  // forma de que esto parpadee.
  setTimeout(() => {
    document.querySelector('.encabezado')?.setAttribute('data-oculto', '');
  }, 10_000);
</script>

<style>
  .encabezado {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-inline: 1rem;
    padding-block: 0.5rem;
    min-height: var(--encabezado);
    background: var(--fondo);
    border-bottom: 1px solid var(--borde);
    overflow: hidden;
    transition: min-height 0.3s ease, padding-block 0.3s ease, opacity 0.25s ease,
      border-color 0.3s ease;
  }

  /* Se repliega una sola vez a los 10 s y no vuelve — le da esa franja al mapa de
     forma permanente. `min-height` en vez de `transform`: con transform el hueco se
     queda reservado en el `display:flex` de `.disposicion` y el mapa no gana nada. */
  .encabezado[data-oculto] {
    min-height: 0;
    padding-block: 0;
    opacity: 0;
    border-bottom-color: transparent;
  }

  .fila {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .detalle {
    display: block;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--tinta-3);
  }

  .alerta {
    flex-shrink: 0;
    background: #c80000;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2em 0.55em;
    border-radius: 999px;
  }

  /* 44 px de alto mínimo: es un objetivo táctil, y probablemente el más importante
     de la página. */
  .buscas {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: 999px;
    background: var(--urgente);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    line-height: 1.15;
  }

  .buscas:hover {
    filter: brightness(1.08);
  }

  /* En pantallas muy angostas el texto largo del botón desplaza el título. */
  @media (max-width: 30rem) {
    .encabezado {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .buscas {
      width: 100%;
      justify-content: center;
    }
  }

  @media (min-width: 48rem) {
    .encabezado {
      padding-inline: 1.5rem;
    }
    h1 {
      font-size: 1.15rem;
    }
    .detalle {
      display: inline;
      margin-left: 0.5rem;
    }
  }
</style>
