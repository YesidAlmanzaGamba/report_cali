---
/**
 * El mapa y lo que va encima: leyenda y ficha del municipio.
 *
 * En móvil ocupa toda la pantalla bajo el encabezado, y la hoja se le monta encima.
 * La leyenda se pliega para no taparlo — en una pantalla de celular seis filas de
 * leyenda son mucho territorio para algo que se consulta una vez.
 */
import type { MmiLevel } from '../lib/mmi';

interface Props {
  leyenda: MmiLevel[];
}

const { leyenda } = Astro.props;
---

<div class="marco">
  <div id="mapa" role="application" aria-label="Mapa de intensidad por municipio">
    <p class="mapa-estado">Mapa de intensidad — se carga en un momento.</p>
  </div>

  <!-- Los botones dicen la pregunta que responden, no el nombre técnico del parámetro.
       Nadie fuera de la sismología sabe qué es «MMI», y quien lo ve asume que es EL
       indicador de daño. -->
  <div class="modos" role="group" aria-label="Qué muestra el color del mapa">
    <button type="button" data-modo="sacudimiento" aria-pressed="true">
      Sacudimiento
      <small>qué tan fuerte tembló</small>
    </button>
    <button type="button" data-modo="expuesta" aria-pressed="false">
      Gente expuesta
      <small>cuánta gente lo vivió</small>
    </button>
  </div>

  <p class="aviso-modo" id="aviso-modo" role="status" hidden></p>

  <!-- Se muestra solo si el evento trae modelo de deslizamiento. -->
  <button type="button" id="capa-deslizamientos" class="capa" aria-pressed="false" hidden>
    Deslizamientos
  </button>

  <button type="button" id="volver-vista" class="volver" hidden>
    ← Ver toda la zona
  </button>

  <!-- Cerrada por defecto: en un celular, seis filas de leyenda tapan justo la parte
       del mapa que la persona vino a mirar. En pantallas anchas la abre `mapa.ts`. -->
  <details class="leyenda">
    <summary>
      <span>Intensidad (MMI)</span>
    </summary>
    <ul>
      {
        leyenda.map((n) => (
          <li>
            <span class="muestra" style={`background:${n.color}`} aria-hidden="true" />
            <span class="grado">{n.roman}</span>
            <span class="desc">{n.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="nota">Escala del ShakeMap del USGS, la misma que usan los organismos de socorro.</p>

    <details class="explica">
      <summary>¿Qué significan los colores?</summary>
      <p>
        El color muestra <strong>qué tan fuerte se sintió el temblor en cada municipio</strong>,
        no cuántos daños hubo.
      </p>
      <p>
        La <strong>magnitud</strong> (7.4) es un solo número para todo el sismo: no cambia
        según dónde estés. La <strong>intensidad</strong> sí cambia de un lugar a otro — es
        lo que la gente sintió y lo que alcanzó a dañarse. Va del I (no se siente) al XII
        (destrucción total).
      </p>
      <p>
        Un municipio puede tener intensidad alta y pocos daños si allí vive poca gente, o
        intensidad media y muchos daños si es una ciudad densa. <strong>Por eso existe el
        otro modo.</strong>
      </p>
    </details>
  </details>

  <!-- Leyenda del segundo modo. Oculta hasta que se activa. -->
  <div class="leyenda leyenda-pob" id="leyenda-poblacion" hidden>
    <h3>Personas donde tembló fuerte</h3>
    <ul id="escala-poblacion"></ul>
    <p class="nota">
      Población que vive donde la intensidad llegó a VI o más — el nivel donde empieza el
      daño. Proyección 2025 del DANE.
    </p>
  </div>

  <aside class="ficha" id="detalle" hidden>
    <button type="button" id="cerrar-detalle" aria-label="Cerrar">×</button>
    <h3 id="detalle-nombre"></h3>
    <p id="detalle-depto" class="depto"></p>

    <!-- Los dos bloques siempre están los dos; `data-modo` (puesto por mapa.ts) decide
         cuál va arriba con `order`, para no perder información al cambiar de modo. -->
    <div class="metricas" id="detalle-metricas" data-modo="sacudimiento">
      <div class="bloque-mmi">
        <p class="mmi">
          <span id="detalle-grado" class="grado-grande"></span>
          <span id="detalle-valor" class="valor"></span>
        </p>
        <p id="detalle-label" class="label"></p>
        <p id="detalle-metodo" class="metodo"></p>
      </div>

      <div class="bloque-poblacion" id="detalle-poblacion" hidden>
        <p id="detalle-pob-total" class="pob-total"></p>
        <p id="detalle-pob-vulnerable" class="pob-vulnerable"></p>
      </div>
    </div>

    <p id="detalle-cobertura" class="cobertura"></p>

    <!-- Leyenda de los puntos de incidentes: solo aparece con tipos presentes (tarea 1). -->
    <div class="leyenda-incidentes" id="detalle-leyenda-incidentes" hidden>
      <h4 class="slide-titulo">Puntos en el mapa</h4>
      <ul id="leyenda-incidentes-lista"></ul>
      <p class="nota-difuso">
        Sólido: ubicación verificada. Difuso: sin verificar, agrupado a ~100 m.
      </p>
    </div>

    <!-- Este carrusel solo aparece cuando el mapa ya cargó (requiere JavaScript por
         definición: la ficha entera sigue oculta con `hidden` sin él), así que no hace
         falta una versión apilada sin JS como la de la hoja inferior. -->
    <div class="carrusel" data-carrusel>
      <div class="carrusel-pista" data-carrusel-pista>
        <section class="carrusel-slide" data-carrusel-slide aria-label="Impacto reportado">
          <h4 class="slide-titulo">Impacto reportado</h4>
          <div id="detalle-cifras" class="cifras-grandes"></div>
        </section>

        <section class="carrusel-slide" data-carrusel-slide aria-label="Ayuda cercana">
          <h4 class="slide-titulo">Ayuda cercana</h4>
          <ul class="canales-fijos">
            <li>
              <span class="etiqueta">Emergencia</span>
              <a class="canal" href="tel:123">Línea 123</a>
            </li>
            <li>
              <span class="etiqueta">Cruz Roja</span>
              <a class="canal" href="https://wa.me/573212139525">WhatsApp +57 321 213 9525</a>
            </li>
          </ul>
          <div id="detalle-ayuda" class="ayuda-puntos"></div>
        </section>
      </div>

      <div class="carrusel-controles">
        <button type="button" class="carrusel-flecha" data-carrusel-prev aria-label="Diapositiva anterior">‹</button>
        <div class="carrusel-puntos" role="group" aria-label="Diapositivas">
          <button type="button" data-carrusel-punto aria-current="true" aria-label="Ver impacto reportado"></button>
          <button type="button" data-carrusel-punto aria-current="false" aria-label="Ver ayuda cercana"></button>
        </div>
        <button type="button" class="carrusel-flecha" data-carrusel-next aria-label="Siguiente diapositiva">›</button>
      </div>
    </div>
  </aside>
</div>

<style>
  .marco {
    position: relative;
    background: var(--fondo-2);
    height: 100%;
    min-height: 20rem;
  }

  #mapa {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .mapa-estado {
    display: grid;
    place-content: center;
    height: 100%;
    margin: 0;
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--tinta-2);
    font-size: 0.9rem;
  }

  /* Sin JavaScript el mapa no puede dibujarse, así que no vale la pena reservarle
     media pantalla en blanco. */
  :global(html:not(.js)) .marco {
    height: auto;
    min-height: 0;
  }
  :global(html:not(.js)) #mapa {
    height: auto;
  }

  /* Interruptor de capa. Debajo del conmutador de modo, alineado a la derecha. */
  .capa {
    position: absolute;
    top: 4rem;
    right: 0.6rem;
    z-index: 6;
    min-height: 36px;
    padding: 0 0.75rem;
    border: 1px solid var(--borde);
    border-radius: 999px;
    background: color-mix(in srgb, var(--fondo) 94%, transparent);
    backdrop-filter: blur(6px);
    color: var(--tinta-2);
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
  }

  .capa[aria-pressed='true'] {
    background: var(--tinta);
    color: var(--fondo);
    border-color: var(--tinta);
  }

  /* Sin mapa base, quien se acerca a un municipio pequeño pierde la referencia de
     dónde está. Este botón es la salida. */
  .volver {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 5;
    min-height: 40px;
    padding: 0 0.85rem;
    border: 1px solid var(--borde);
    border-radius: 999px;
    background: color-mix(in srgb, var(--fondo) 94%, transparent);
    backdrop-filter: blur(6px);
    color: var(--tinta);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }

  /* Los controles de zoom de MapLibre viven arriba a la izquierda. */
  :global(html.js) .volver {
    left: 3.4rem;
  }

  /* ── Conmutador de modo ──────────────────────────────────────────────── */
  /* Visible sobre el mapa, no escondido en un menú: en una emergencia nadie va a
     buscar un ajuste. */
  .modos {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 6;
    display: flex;
    gap: 2px;
    padding: 2px;
    background: color-mix(in srgb, var(--fondo) 94%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--borde);
    border-radius: 999px;
  }

  .modos button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    min-height: 44px;
    padding: 0.25rem 0.7rem;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--tinta-2);
    font-size: 0.8rem;
    font-weight: 650;
    line-height: 1.15;
    cursor: pointer;
  }

  .modos button small {
    font-size: 0.62rem;
    font-weight: 400;
    color: var(--tinta-3);
  }

  .modos button[aria-pressed='true'] {
    background: var(--tinta);
    color: var(--fondo);
  }
  .modos button[aria-pressed='true'] small {
    color: color-mix(in srgb, var(--fondo) 75%, transparent);
  }

  /* El aviso que aparece al cambiar de modo y se va solo. */
  .aviso-modo {
    position: absolute;
    top: 4.6rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 7;
    margin: 0;
    padding: 0.45rem 0.9rem;
    max-width: calc(100% - 1.5rem);
    border-radius: 999px;
    background: var(--tinta);
    color: var(--fondo);
    font-size: 0.78rem;
    text-align: center;
    animation: aparecer 0.25s ease-out;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translate(-50%, -6px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .aviso-modo[data-yendose] {
    opacity: 0;
    transition: opacity 0.6s;
  }

  /* ── Leyenda ─────────────────────────────────────────────────────────── */
  .leyenda {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    max-width: 15rem;
    background: color-mix(in srgb, var(--fondo) 93%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    font-size: 0.78rem;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 38px;
    padding: 0 0.7rem;
    cursor: pointer;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tinta-3);
    font-weight: 600;
  }

  .leyenda ul {
    list-style: none;
    margin: 0;
    padding: 0 0.7rem 0.2rem;
    display: grid;
    gap: 0.28rem;
  }

  .leyenda li {
    display: grid;
    grid-template-columns: 0.9rem 2rem 1fr;
    align-items: center;
    gap: 0.45rem;
  }

  .muestra {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, var(--tinta) 25%, transparent);
  }

  .grado {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .desc {
    color: var(--tinta-2);
  }

  .nota {
    margin: 0.45rem 0 0;
    padding: 0 0.7rem 0.6rem;
    font-size: 0.68rem;
    color: var(--tinta-3);
  }

  .explica {
    border-top: 1px solid var(--borde);
    margin: 0 0.7rem 0.6rem;
  }

  .explica summary {
    padding: 0.4rem 0;
    min-height: 36px;
    font-size: 0.7rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--acento);
    font-weight: 600;
  }

  .explica p {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--tinta-2);
  }

  /* La leyenda del segundo modo comparte estilos con la de intensidad. */
  .leyenda-pob h3 {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.75rem;
    color: var(--tinta-2);
    padding: 0.55rem 0.7rem 0;
  }

  .leyenda-pob ul {
    padding-top: 0.35rem;
  }

  /* Estas filas las construye `mapa.ts` con createElement, así que NO llevan el atributo
     de alcance que Astro le pone al marcado estático. Sin `:global` los estilos no las
     alcanzan y la leyenda sale sin sus cuadros de color — que es justo lo que la hace
     leerse. */
  .leyenda-pob :global(li) {
    display: grid;
    grid-template-columns: 0.9rem 1fr;
    align-items: center;
    gap: 0.45rem;
  }

  .leyenda-pob :global(.muestra) {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, var(--tinta) 25%, transparent);
  }

  .leyenda-pob :global(.desc) {
    color: var(--tinta-2);
  }

  /* ── Ficha del municipio ─────────────────────────────────────────────── */
  /* `top` libra el conmutador de modo, que ancla en el mismo `right:0.6rem` y sin esto
     la ficha lo tapa por completo en cuanto se abre un municipio (tarea 6). */
  .ficha {
    position: absolute;
    right: 0.6rem;
    top: 3.9rem;
    width: min(19rem, calc(100% - 1.2rem));
    max-height: calc(100% - 4.5rem);
    overflow-y: auto;
    background: color-mix(in srgb, var(--fondo) 96%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    padding: 0.85rem 1rem 1rem;
  }

  .ficha h3 {
    margin: 0 0 0.1rem;
    font-size: 1.1rem;
    padding-right: 1.5rem;
  }

  .depto {
    margin: 0 0 0.7rem;
    color: var(--tinta-3);
    font-size: 0.83rem;
  }

  /* Los dos bloques de cifras (MMI y población) de la ficha; `order` decide cuál se ve
     primero según el modo activo del mapa (tarea 4). */
  .metricas {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .bloque-mmi,
  .bloque-poblacion {
    order: 1;
  }

  .metricas[data-modo='expuesta'] .bloque-poblacion {
    order: 0;
  }

  /* El bloque que no corresponde al modo activo se queda, pero discreto: sigue siendo
     información real, no ruido, así que no desaparece — solo cede el primer plano. */
  .metricas[data-modo='expuesta'] .bloque-mmi,
  .metricas:not([data-modo='expuesta']) .bloque-poblacion {
    font-size: 0.85em;
    opacity: 0.72;
  }

  .mmi {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
  }

  .grado-grande {
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.15em 0.4em;
    border-radius: 8px;
  }

  .valor {
    font-variant-numeric: tabular-nums;
    color: var(--tinta-2);
  }

  .label {
    margin: 0.55rem 0 0;
    font-size: 0.88rem;
  }

  .metodo {
    margin: 0.5rem 0 0;
    font-size: 0.73rem;
    color: var(--tinta-3);
  }

  .pob-total {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .pob-vulnerable {
    margin: 0.3rem 0 0;
    font-size: 0.82rem;
    color: var(--tinta-2);
  }

  .pob-vulnerable:empty {
    display: none;
  }

  /* ── Leyenda de incidentes (tarea 1) ─────────────────────────────────── */
  .leyenda-incidentes {
    margin: 0.8rem 0 0;
  }

  .leyenda-incidentes ul {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.28rem;
  }

  /* Filas creadas por mapa.ts con createElement: sin el atributo de alcance de Astro,
     así que los estilos tienen que ser :global para alcanzarlas (mismo motivo que
     .leyenda-pob más arriba). */
  .leyenda-incidentes :global(li) {
    display: grid;
    grid-template-columns: 0.9rem 1fr;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
  }

  .leyenda-incidentes :global(.muestra) {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tinta) 25%, transparent);
  }

  .leyenda-incidentes :global(.desc) {
    color: var(--tinta-2);
  }

  .nota-difuso {
    margin: 0.45rem 0 0;
    font-size: 0.7rem;
    color: var(--tinta-3);
  }

  /* «Sin cartografía» no es lo mismo que «sin daños». Lo decimos con todas las letras
     y con peso visual, porque un mapa vacío se lee como lo segundo. */
  .cobertura {
    margin: 0.8rem 0 0;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .cobertura:empty {
    display: none;
  }

  .cobertura--con {
    background: var(--fondo-3);
    color: var(--tinta-2);
  }

  .cobertura--sin {
    background: var(--urgente-fondo);
    color: var(--tinta);
    border-left: 3px solid var(--urgente);
  }

  #cerrar-detalle {
    position: absolute;
    top: 0.3rem;
    right: 0.4rem;
    width: 34px;
    height: 34px;
    background: none;
    border: none;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--tinta-3);
    cursor: pointer;
  }

  /* ── Carrusel: Impacto · Ayuda cercana ──────────────────────────────── */
  .carrusel {
    margin-top: 0.8rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--borde);
  }

  .slide-titulo {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tinta-3);
  }

  .carrusel-pista {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carrusel-pista::-webkit-scrollbar {
    display: none;
  }

  .carrusel-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }

  /* Estado vacío honesto: ni oculto ni inventado. Se usa tanto en «sin cifras» como en
     «sin puntos de ayuda cartografiados». */
  :global(.vacio) {
    margin: 0;
    padding: 0.6rem 0.75rem;
    background: var(--fondo-3);
    color: var(--tinta-2);
    border-radius: var(--radio);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .cifras-grandes {
    display: grid;
    gap: 0.5rem;
  }

  :global(.cifra-grande) {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.75rem;
    background: var(--fondo-2);
    border: 1px solid var(--borde);
    border-left: 4px solid var(--tinta-3);
    border-radius: var(--radio);
  }

  :global(.cifra-grande.fresh) { border-left-color: var(--fresco); }
  :global(.cifra-grande.aging) { border-left-color: var(--envejece); }
  :global(.cifra-grande.stale) { border-left-color: var(--obsoleto); }

  :global(.cifra-grande .n) {
    font-size: clamp(1.5rem, 8vw, 1.9rem);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  :global(.cifra-grande .q) {
    font-size: 0.82rem;
    font-weight: 600;
  }

  :global(.cifra-grande .f) {
    display: block;
    font-size: 0.71rem;
    color: var(--tinta-3);
    margin-top: 0.15rem;
  }

  :global(.cifra-grande .f a) {
    color: inherit;
  }

  /* Canales ya verificados en BuscasAlguien.astro, repetidos aquí sin inventar
     agencias ni teléfonos nuevos. */
  .canales-fijos {
    list-style: none;
    margin: 0 0 0.6rem;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .canales-fijos li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    background: var(--fondo);
    border: 1px solid var(--urgente);
    border-radius: var(--radio);
    padding: 0.5rem 0.7rem;
  }

  .canales-fijos .etiqueta {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--tinta-3);
  }

  .canales-fijos .canal {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-weight: 700;
    color: var(--tinta);
  }

  .ayuda-puntos {
    display: grid;
    gap: 0.5rem;
  }

  :global(.punto-ayuda) {
    display: block;
