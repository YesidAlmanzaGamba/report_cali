  /* En celular la ficha se ancla abajo, encima de la hoja asomada: arriba a la
     derecha tapa justo la zona que la persona acaba de tocar. */
  @media (max-width: 40rem) {
    /* Fuera los botones de zoom en celular: se hace pinza, y ese rincón vale más como
       sitio para «← Ver todo». En pantallas anchas se quedan — ahí no hay pinza y son la
       única forma de acercarse con el ratón. El teclado sigue cubierto en los dos casos:
       con el mapa enfocado, `+` y `−` acercan y alejan igual. */
    :global(.maplibregl-ctrl-top-left) {
      display: none;
    }

    /* Ya no hay zoom que esquivar, así que la fila recupera ese ancho. */
    :global(html.js) .controles-superiores {
      padding-left: 0;
    }

    .ficha {
      top: auto;
      bottom: calc(var(--asomada) + 0.6rem);
      left: 0.6rem;
      right: 0.6rem;
      width: auto;
      max-height: 50%;
    }

    /* ── Con un municipio abierto, la pantalla se parte en dos ────────────
       `data-ficha` lo pone `mapa.ts` en `<html>` al abrir la ficha y lo quita al cerrar.

       **Mitad y mitad: mapa arriba, ficha abajo.** Antes la ficha ya estaba limitada al
       50 %, pero por debajo seguía asomada la hoja con su resumen de fallecidos — 104 px
       más— así que entre las dos se quedaban con dos tercios de la pantalla y al mapa le
       tocaba un tercio. Ahora la ficha se pega abajo del todo y ocupa exactamente la
       mitad; la hoja se retira (regla en `Hoja.astro`) y vuelve al cerrar la ficha.

       Se van también el conmutador de modo, la capa y las leyendas: son ajustes de la
       vista general. Las leyendas además se montaban sobre la ficha —«Personas donde
       tembló fuerte» flotando encima del aviso de cobertura—, y replegarlas no bastaba
       porque el título replegado sigue ocupando su rectángulo.

       `← Ver todo` **no** se va: es la salida, y sin mapa base es lo único que devuelve
       la referencia de dónde está uno. */
    :global(html[data-ficha]) .modos,
    :global(html[data-ficha]) .capa,
    :global(html[data-ficha]) .leyenda {
      display: none;
    }

    :global(html[data-ficha]) .ficha {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: auto;
      height: 50%;
      max-height: 50%;
      /* Pegada al borde: sin esquinas ni bordes abajo, que es lo que la hace leerse como
         media pantalla y no como una tarjeta flotando. */
      border-radius: var(--radio) var(--radio) 0 0;
      border-left: none;
      border-right: none;
      border-bottom: none;
      /* El indicador de inicio del teléfono se come la última línea si no. */
      padding-bottom: calc(1rem + var(--seguro-abajo));
    }

    .leyenda {
      bottom: calc(var(--asomada) + 0.6rem);
      max-width: 12.5rem;
      font-size: 0.72rem;
      /* En celular el cuadro además arranca por encima de la hoja asomada, así que hay
         que descontarla del techo o volvería a desbordar por arriba. */
      max-height: calc(100% - var(--asomada) - var(--ficha-top, 3.9rem) - 1.2rem);
    }

    :global(html:not(.js)) .leyenda,
    :global(html:not(.js)) .ficha {
      position: static;
      max-width: none;
      margin: 0.6rem;
      backdrop-filter: none;
    }
  }
