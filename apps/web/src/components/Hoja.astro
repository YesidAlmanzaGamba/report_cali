---
/**
 * Hoja inferior con los módulos.
 *
 * Dos diseños en un solo marcado:
 *
 * · **Sin JavaScript** (por defecto) — es contenido apilado normal. Se ven todos los
 *   módulos, uno tras otro, como en cualquier página. El asa y el conmutador se ocultan
 *   porque sin JavaScript no harían nada.
 * · **Con JavaScript** (`html.js`) — se vuelve una hoja fija sobre el mapa, con tres
 *   anclajes y un módulo visible a la vez.
 *
 * El orden importa: lo que funciona sin JavaScript es el estado base, no el de respaldo.
 * Así una conexión que falla a medias deja una página utilizable en vez de una en blanco.
 */
interface Modulo {
  id: string;
  etiqueta: string;
}

interface CifraClave {
  valor: string;
  etiqueta: string;
  fuente: string;
  cuando: string;
}

interface Props {
  /** Línea que se lee sin abrir la hoja. Debe ser la cifra que más importa. */
  resumen: string;
  /** Tira horizontal de cifras nacionales, visible sin desplegar la hoja. */
  cifrasClave?: CifraClave[];
  modulos: Modulo[];
}

const { resumen, cifrasClave = [], modulos } = Astro.props;
const primero = modulos[0]?.id ?? '';
---

<section class="hoja" id="hoja" data-estado="asomada" aria-label="Información del evento">
  <button class="asa" type="button" aria-expanded="false" aria-controls="hoja-cuerpo">
    <span class="agarre" aria-hidden="true"></span>
    {/* El resumen sigue existiendo para lectores de pantalla y para cuando no hay
        cifras que poner en la tira; visualmente lo sustituye la tira. */}
    <span class="resumen">{resumen}</span>
    <span class="chevron" aria-hidden="true">⌃</span>
    <span class="sr-only">Mostrar u ocultar la información</span>
  </button>

  {
    cifrasClave.length > 0 && (
      <div class="tiras-marco" id="tiras-marco">
        <ul class="tiras" id="tiras" aria-label="Cifras nacionales">
          {cifrasClave.map((c) => (
            <li title={`${c.fuente} · ${c.cuando.slice(0, 16).replace('T', ' ')}`}>
              <span class="tira-valor">{c.valor}</span>
              <span class="tira-etiqueta">{c.etiqueta}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="cuerpo" id="hoja-cuerpo">
    <div class="conmutador" role="tablist" aria-label="Módulos">
      {
        modulos.map((m) => (
          <button
            role="tab"
            type="button"
            id={`tab-${m.id}`}
            data-modulo={m.id}
            aria-controls={`panel-${m.id}`}
            aria-selected={m.id === primero ? 'true' : 'false'}
            tabindex={m.id === primero ? 0 : -1}
          >
            {m.etiqueta}
          </button>
        ))
      }
    </div>

    <div class="modulos">
      {
        modulos.map((m) => (
          <div
            class="modulo"
            id={`panel-${m.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${m.id}`}
            data-modulo={m.id}
            data-activo={m.id === primero ? '' : undefined}
          >
            <slot name={m.id} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ── Estado base: contenido apilado, sin JavaScript ──────────────────── */
  .hoja {
    background: var(--fondo);
  }

  .asa,
  .conmutador {
    display: none;
  }

  .modulo {
    padding-inline: 1rem;
    max-width: var(--ancho);
    margin-inline: auto;
  }

  .modulo + .modulo {
    border-top: 1px solid var(--borde);
    margin-top: 2rem;
    padding-top: 2rem;
  }

  /* ── Con JavaScript: hoja sobre el mapa ──────────────────────────────── */
  :global(html.js) .hoja {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 20;
    height: 92dvh;
    display: flex;
    flex-direction: column;
    border-radius: 14px 14px 0 0;
    border: 1px solid var(--borde);
    border-bottom: none;
    box-shadow: 0 -6px 28px rgb(0 0 0 / 0.16);
    /* Asomada: solo se ve el asa. `--asomada` sale de tokens.css. */
    transform: translateY(calc(100% - var(--asomada)));
    transition: transform 0.2s cubic-bezier(0.32, 0.72, 0, 1);
  }

  :global(html.js) .hoja[data-estado='media'] {
    transform: translateY(45%);
  }

  /* Con la ficha de un municipio abierta en celular, la hoja se retira del todo.
     `data-ficha` lo pone `mapa.ts` en `<html>`.

     Su asa asomada mide 104 px, y sumados a la media pantalla de la ficha dejaban el
     mapa en un tercio. La idea es mitad y mitad: mapa arriba, municipio abajo. Vuelve
     sola al cerrar la ficha, y como esto es un `transform` viaja con la misma
     transición que ya tenía — no aparece ni desaparece de golpe.

     Va después de los estados para ganarles por orden: la hoja puede estar en
     `asomada`, `media` o `completa` cuando alguien toca un municipio, y desde las tres
     tiene que retirarse igual. El `transform` en línea de un arrastre lo limpia
     `colapsarHoja()`, que `mapa.ts` llama justo antes de marcar. */
  @media (max-width: 40rem) {
    :global(html.js[data-ficha]) .hoja,
    :global(html.js[data-ficha]) .hoja[data-estado='media'],
    :global(html.js[data-ficha]) .hoja[data-estado='completa'] {
      transform: translateY(100%);
    }
  }

  :global(html.js) .hoja[data-estado='completa'] {
    transform: translateY(0);
  }

  /* Durante el arrastre mandan los píxeles, no los anclajes: la transición haría que
     la hoja persiguiera al dedo con retraso. */
  :global(html.js) .hoja[data-arrastrando] {
    transition: none;
  }

  /**
   * El asa NO ocupa toda la parte asomada.
   *
   * Llevaba `min-height: var(--asomada)`, así que el botón se comía la franja visible
   * entera y empujaba la tira de cifras por debajo del borde: en el móvil se veía el
   * asa, un hueco grande y nada más. Ahora mide lo que mide su contenido y la tira cabe
   * dentro de la franja, que es donde tiene que estar.
   */
  :global(html.js) .asa {
    display: block;
    width: 100%;
    padding: 0.45rem 1.1rem 0.1rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    /* Solo el asa captura el gesto. Si se pusiera en toda la hoja, arrastrar dentro
       de los módulos dejaría de desplazar el contenido. */
    touch-action: none;
  }

  .agarre {
    grid-area: agarre;
    justify-self: center;
    width: 2.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: var(--tinta-3);
    opacity: 0.5;
    margin-bottom: 0.5rem;
  }

  .resumen {
    grid-area: resumen;
    font-weight: 650;
    font-size: 0.98rem;
    line-height: 1.3;
  }

  /* Con tira, el resumen sobra visualmente: repite la primera cifra y gasta un renglón
     entero de una franja que se le quita al mapa. Sigue en el DOM para lectores de
     pantalla y para cuando no hay cifras. */
  :global(html.js) .hoja:has(.tiras) .resumen {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /**
   * Tira de cifras nacionales. Va FUERA del botón a propósito: una lista con
   * desplazamiento lateral dentro de un `<button>` es marcado inválido y además el gesto
   * de deslizar acabaría abriendo la hoja.
   */
  /**
   * El movimiento va por `transform`, no por `scrollLeft`.
   *
   * `scrollLeft` redondea a píxeles enteros: a 16 px/s eso es un salto cada cuatro
   * fotogramas, que es exactamente la sensación «a pasos» que se veía. Un `translateX`
   * lo interpola el compositor con precisión subpíxel y sin tocar el hilo principal.
   *
   * El marco es quien desplaza a mano; la lista de dentro es la que se anima. Al primer
   * gesto se cancela la animación y el marco se queda como una lista normal.
   */
  .tiras-marco {
    margin: 0.5rem 0 0;
    overflow-x: auto;
    /* El navegador se queda el gesto horizontal; así no compite con el arrastre de la
       hoja ni con el desplazamiento vertical de la página. */
    touch-action: pan-x;
    scrollbar-width: none;
  }

  .tiras-marco::-webkit-scrollbar {
    display: none;
  }

  .tiras {
    display: flex;
    gap: 0.55rem;
    margin: 0;
    padding: 0 0 0.15rem;
    list-style: none;
    width: max-content;
  }

  :global(html.js) .tiras[data-desfile] {
    animation: desfile-cifras var(--desfile-duracion, 30s) linear infinite;
  }

  @keyframes desfile-cifras {
    from {
      transform: translateX(0);
    }
    to {
      /* La mitad, porque las cifras están duplicadas: al llegar ahí la copia está justo
         donde estaba el original y el reinicio no se ve. */
      transform: translateX(calc(-50% - 0.275rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .tiras[data-desfile] {
      animation: none;
    }
  }

  .tiras li {
    flex: 0 0 auto;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: var(--fondo-2);
    line-height: 1.15;
  }

  /* La primera cifra es la que más pesa; se lee antes que las demás. */
  .tiras li:first-child .tira-valor {
    color: var(--urgente);
  }

  .tira-valor {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .tira-etiqueta {
    display: block;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tinta-3);
    white-space: nowrap;
  }

  /* Fuera del flujo: como fila propia del asa se llevaba un renglón entero de la franja
     asomada para dibujar una flechita. Va flotando arriba a la derecha. */
  :global(html.js) .hoja:has(.tiras) .chevron {
    position: absolute;
    top: 0.5rem;
    right: 1.1rem;
    z-index: 1;
  }

  .chevron {
    grid-area: chevron;
    color: var(--tinta-3);
    font-size: 1.1rem;
    transition: transform 0.2s;
  }

  :global(html.js) .hoja[data-estado='completa'] .chevron {
    transform: rotate(180deg);
  }

  :global(html.js) .cuerpo {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  :global(html.js) .conmutador {
    display: flex;
    gap: 0.25rem;
    padding: 0 1rem 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--borde);
  }
  :global(html.js) .conmutador::-webkit-scrollbar {
    display: none;
  }

  .conmutador button {
    flex-shrink: 0;
    min-height: 40px;
    padding: 0 0.85rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--fondo-2);
    color: var(--tinta-2);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .conmutador button[aria-selected='true'] {
    background: var(--tinta);
    color: var(--fondo);
  }

  :global(html.js) .modulos {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    padding-bottom: calc(2rem + var(--seguro-abajo));
  }

  :global(html.js) .modulo {
    display: none;
    padding: 1.1rem 1rem 0;
  }

  :global(html.js) .modulo[data-activo] {
    display: block;
  }

  :global(html.js) .modulo + .modulo {
    border-top: none;
    margin-top: 0;
    padding-top: 1.1rem;
  }

  /* ── Escritorio: panel fijo al lado del mapa, mismos componentes ─────── */
  @media (min-width: 60rem) {
    :global(html.js) .hoja {
      inset-block: var(--encabezado) 0;
      inset-inline: auto 0;
      width: min(27rem, 40vw);
      height: auto;
      transform: none;
      border-radius: 0;
      border-right: none;
      border-bottom: 1px solid var(--borde);
      box-shadow: -4px 0 20px rgb(0 0 0 / 0.08);
    }

    /* En escritorio no hay que arrastrar nada: el panel ya está abierto. */
    :global(html.js) .asa .agarre,
    :global(html.js) .asa .chevron {
      display: none;
    }

    :global(html.js) .asa {
      min-height: 0;
      grid-template-areas: 'resumen resumen';
      padding: 1rem 1.1rem 0.75rem;
      cursor: default;
    }
  }
</style>
