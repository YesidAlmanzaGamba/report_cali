---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import type { Observation } from '@report-cali/ingest/schema';

import Base from '../layouts/Base.astro';
import Alcance from '../components/Alcance.astro';
import BuscasAlguien from '../components/BuscasAlguien.astro';
import Cifras from '../components/Cifras.astro';
import Descargas from '../components/Descargas.astro';
import Encabezado from '../components/Encabezado.astro';
import Hoja from '../components/Hoja.astro';
import Mapa from '../components/Mapa.astro';
import TablaMunicipios from '../components/TablaMunicipios.astro';
import { levelsPresent } from '../lib/mmi';
import { ETIQUETAS } from '../lib/metricas';

interface Municipio {
  pcode: string;
  name: string;
  admin1_pcode: string;
  admin1_name: string;
  mmi: number;
  mmi_roman: string;
  method: 'grid' | 'centroid';
}

const DATA = resolve(process.cwd(), '../../data');
const leer = async (p: string) => JSON.parse(await readFile(resolve(DATA, p), 'utf8'));

const evento = await leer('event/event.json');
const mmiData = await leer('event/mmi-by-municipality.json');
const municipios: Municipio[] = mmiData.municipalities;

const afectacion: { observations: Observation[] } = await leer(
  'observations/afectacion.json',
).catch(() => ({ observations: [] }));

const nombres = new Map(municipios.map((m) => [m.pcode, `${m.name}, ${m.admin1_name}`]));
const ahora = new Date();

// Los 25 de mayor intensidad, más cualquier municipio con cifras reportadas: si alguien
// reportó daños ahí, es relevante aunque su sacudimiento no esté entre los más fuertes.
const conCifras = new Set(afectacion.observations.map((o) => o.pcode));
const listados = [
  ...municipios.slice(0, 25),
  ...municipios.slice(25).filter((m) => conCifras.has(m.pcode)),
];

const leyenda = levelsPresent(municipios.map((m) => m.mmi)).reverse();

const fechaLocal = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'long',
  timeZone: 'America/Bogota',
}).format(new Date(evento.originTime));

/**
 * La MÁS RECIENTE de cada métrica, no la primera que aparezca.
 *
 * Antes se cogía la primera del archivo, y el archivo conserva a propósito los balances
 * viejos para que se vea cómo se corrigen: el encabezado llegó a mostrar 181 fallecidos
 * cuando el balance vigente de la UNGRD ya decía 265. En un mapa de emergencia, la cifra
 * de portada tiene que ser la última, no la que estuviera de primeras en un JSON.
 */
const ultimaNacional = (metric: string) =>
  afectacion.observations
    .filter((o) => o.pcode === 'CO' && o.metric === metric)
    .sort((a, b) => b.observed_at.localeCompare(a.observed_at))[0];

const nacional = ultimaNacional('deaths_confirmed');
const resumen = nacional
  ? `${nacional.value.toLocaleString('es-CO')} ${ETIQUETAS[nacional.metric].toLowerCase()} · ${municipios.length.toLocaleString('es-CO')} municipios afectados`
  : `${municipios.length.toLocaleString('es-CO')} municipios con sacudimiento registrado`;

/**
 * Las cifras que se leen sin abrir la hoja, en una tira horizontal.
 *
 * Orden por lo que se busca primero en una emergencia: muertos, desaparecidos, heridos,
 * y después el daño material. Solo entran las que existen — una tira con huecos «—» no
 * informa de nada.
 */
/**
 * `people_affected` NO entra aquí, y no es un olvido.
 *
 * El modelo de deslizamientos del USGS escribe su población expuesta con esa misma
 * métrica y con la hora de actualización del evento, así que siempre gana el «más
 * reciente»: la tira mostraba «4.400 personas afectadas» cuando el balance de la UNGRD
 * dice 53.816. Exposición modelada y afectados reportados no son lo mismo y no deberían
 * compartir métrica — el arreglo de fondo es separarlas en `packages/ingest`, y está
 * anotado en ROADMAP. Hasta entonces, mejor no enseñar la cifra que enseñar la mala.
 */
const CLAVE = [
  'deaths_confirmed',
  'missing_reported',
  'injured',
  'buildings_collapsed',
] as const;

const cifrasClave = CLAVE.map((metric) => ultimaNacional(metric))
  .filter((o): o is NonNullable<typeof o> => Boolean(o))
  .map((o) => ({
    valor: o.value.toLocaleString('es-CO'),
    etiqueta: ETIQUETAS[o.metric],
    fuente: o.source.name,
    cuando: o.observed_at,
  }));

cifrasClave.push({
  valor: municipios.length.toLocaleString('es-CO'),
  etiqueta: 'Municipios afectados',
  fuente: 'Cruce del ShakeMap del USGS con los 1.122 municipios',
  cuando: mmiData.generated_at ?? evento.originTime,
});

const modulos = [
  { id: 'cifras', etiqueta: 'Cifras' },
  { id: 'ayuda', etiqueta: 'Buscar personas' },
  { id: 'municipios', etiqueta: 'Municipios' },
  { id: 'descargas', etiqueta: 'Descargas' },
  { id: 'alcance', etiqueta: 'Sobre esto' },
];
---

<Base
  titulo="Mapa de situación — Terremoto Colombia, 10 de agosto de 2026"
  descripcion="Mapa abierto de la intensidad y afectación del terremoto de magnitud 7.4 del 10 de agosto de 2026 en Colombia. Cada cifra con su fuente y su hora."
>
  <div class="disposicion">
    <Encabezado magnitud={evento.magnitude} alerta={evento.alert} fechaLocal={fechaLocal} />

    <main id="contenido" class="zona-mapa">
      <Mapa leyenda={leyenda} />
    </main>
  </div>

  <Hoja resumen={resumen} cifrasClave={cifrasClave} modulos={modulos}>
    <Fragment slot="cifras">
      <Cifras observaciones={afectacion.observations} municipios={nombres} ahora={ahora} />
    </Fragment>

    <Fragment slot="ayuda">
      <BuscasAlguien />
    </Fragment>

    <Fragment slot="municipios">
      <TablaMunicipios municipios={listados} total={municipios.length} />
    </Fragment>

    <Fragment slot="descargas">
      <Descargas totalMunicipios={municipios.length} />
    </Fragment>

    <Fragment slot="alcance">
      <Alcance
        eventoUrl={evento.url}
        eventoId={evento.id}
        generadoEn={mmiData.generated_at}
      />
    </Fragment>
  </Hoja>

  <script>
    import { iniciarHoja } from '../lib/hoja';
    import { prepararMapa } from '../lib/cargar-mapa';
    import { iniciarCarruseles } from '../lib/carrusel';

    iniciarHoja();
    prepararMapa();
    // Vive fuera de #mapa (ver Mapa.astro), así que no depende de que el mapa cargue.
    iniciarCarruseles();
  </script>
</Base>

<style>
  /* Sin JavaScript esto es flujo normal: encabezado, mapa, y debajo los módulos
     apilados. Con JavaScript el mapa ocupa la pantalla y la hoja se le monta encima. */
  :global(html.js) .disposicion {
    display: flex;
    flex-direction: column;
    height: 100dvh;
  }

  :global(html.js) .zona-mapa {
    flex: 1;
    min-height: 0;
  }

  /* En escritorio la hoja es un panel lateral, así que el mapa le cede el ancho. */
  @media (min-width: 60rem) {
    :global(html.js) .zona-mapa {
      margin-right: min(27rem, 40vw);
    }
  }
</style>
